<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_launcher"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btn_play"
            style="@style/PrimaryButton"
            android:text="@string/play"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/preset_quality"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/preset_quality"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/preset_balanced"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/preset_balanced"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/preset_fast"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/preset_fast"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_settings"
            style="@style/SecondaryButton"
            android:text="@string/settings"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_touch_editor"
            style="@style/SecondaryButton"
            android:text="@string/touch_editor"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_grant_files"
            style="@style/SecondaryButton"
            android:text="@string/grant_files"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_log"
            style="@style/SecondaryButton"
            android:text="@string/log"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/about_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_text"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingTop="16dp" />
    </LinearLayout>
</ScrollView>
